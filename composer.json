{
    "name": "bliptrace/wordpress",
    "version": "1.0.0",
    "description": "WordPress plugin SDK for Bliptrace — captures PHP errors and exceptions and ships them to the ingest API. Thin adapter over bliptrace/php.",
    "keywords": [
        "wordpress",
        "bliptrace",
        "error-tracking",
        "observability",
        "sdk",
        "php"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bliptrace/php": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Bliptrace\\WordPress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bliptrace\\WordPress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../bliptrace-php",
            "options": {
                "symlink": true,
                "versions": { "bliptrace/php": "2.0.0" }
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
